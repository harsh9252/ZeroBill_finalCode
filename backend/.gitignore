node_modules/
.env.production
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store

# Add to .gitignore
echo "Backend/.env" >> .gitignore
echo "Backend/package-lock.json" >> .gitignore
echo "Frontend/dist/" >> .gitignore
echo "Website/dist/" >> .gitignore
 
# Remove tracked files
git rm --cached Backend/.env 2>/dev/null || true
git rm --cached Backend/package-lock.json 2>/dev/null || true
git rm -r --cached Frontend/dist/ 2>/dev/null || true
git rm -r --cached Website/dist/ 2>/dev/null || true
 
# Commit and push
git add .gitignore
git commit -m "fix: update gitignore"
git push origin main