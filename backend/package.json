{
  "name": "backend",
  "version": "1.0.0",
  "description": "InvoiceBillBook Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup:business": "node scripts/setupBusinessTable.js",
    "setup:billing": "node scripts/setupBillingTable.js",
    "setup:terms": "node scripts/insertDummyTerms.js",
    "setup:terms-auto": "node scripts/checkAndInsertTerms.js",
    "setup:terms-rich": "node scripts/insertRichTerms.js",
    "setup:payment-in": "node scripts/setupPaymentInTable.js",
    "insert:dummy-payment-in": "node scripts/insertDummyPaymentIn.js",
    "verify:terms": "node scripts/verifyTermsSetup.js",
    "migrate:stamp": "node scripts/addStampColumn.js",
    "verify:stamp": "node scripts/verifyStampMigration.js",
    "setup:superadmin": "node scripts/setupSuperAdmin.js",
    "delete:superadmin-tables": "node scripts/quickDeleteTables.js",
    "check:schema": "node scripts/checkDatabaseSchema.js",
    "compare:databases": "node scripts/compareDatabases.js",
    "compare:sql": "node scripts/compareFromSQLFile.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.6",
    "bcrypt": "^6.0.0",
    "cheerio": "1.0.0-rc.12",
    "cors": "^2.8.5",
    "dompurify": "^3.0.11",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "googleapis": "^171.4.0",
    "isomorphic-dompurify": "^2.11.0",
    "jsdom": "^21.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "overrides": {
    "cssstyle": "3.0.0",
    "whatwg-encoding": "2.0.0",
    "html-encoding-sniffer": "3.0.0",
    "parse5": "6.0.1"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "controllers/*.js",
      "middleware/*.js",
      "utils/*.js",
      "models/*.js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ]
  }
}
